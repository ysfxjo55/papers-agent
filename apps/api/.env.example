# ── apps/api/.env ──────────────────────────────────────────────────────────
# Copy to apps/api/.env and fill in. Never commit the real .env.

# Postgres connection (Neon in production, or local Postgres for dev)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Anthropic API key for the tutor (/chat)
ANTHROPIC_API_KEY=sk-ant-...

# Comma-separated list of allowed CORS origins (the web app's URLs).
# Defaults to localhost dev origins if unset. Add your Vercel URL for production:
# ALLOW_ORIGINS=http://localhost:3000,https://ai-mind.vercel.app
ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Secret used to sign session JWTs for /auth. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-never-commit-real-value

# "true" in production (web app and API on different domains) so the session
# cookie is sent as SameSite=None; Secure, which cross-site cookies require.
# Leave "false" for local dev (localhost -> 127.0.0.1 is same-site enough for Lax).
AUTH_COOKIE_CROSS_SITE=false
